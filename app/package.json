{
  "name": "strecke-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Strecke PWA: Station practice on the core engine; content from the demo deck or the learner's published sheet.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@fontsource/overpass": "5.3.0",
    "@fontsource/overpass-mono": "5.3.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.1",
    "fake-indexeddb": "6.2.5",
    "preact-render-to-string": "6.8.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "3.2.7"
  }
}
